{
  "schema": "pli-recipe-v1",
  "notes": "Paths are generalized: $MODELS = model directory, $LLAMA_* = llama.cpp checkout. $GPU0..$GPU3 = the four GPU UUIDs in CUDA order; on the test rig $GPU3 is the PCIe Gen4 x8 card. Every speed sample was preceded by scripts/prewarm.sh over all model files inside the same lock hold.",
  "recipes": [
    {
      "id": "glm53-a16-ub2048",
      "status": "baseline (measured, numerically gated)",
      "engine": {
        "repo": "https://github.com/ggml-org/llama.cpp",
        "commit": "3d65c90d04d337e88f2b1f7f0061f40a5324e662",
        "patches": []
      },
      "model": {
        "hf_repo": "AesSedai/GLM-5.3-Flash-GGUF",
        "file": "Q4_K_M, 6 shards, 201,973,194,104 bytes"
      },
      "binary": "$LLAMA_GLM/build/bin/llama-server",
      "argv": [
        "-m",
        "$MODELS/glm-5.3-flash-q4_k_m/GLM-5.3-Flash-Q4_K_M-00001-of-00006.gguf",
        "-ngl",
        "99",
        "-ts",
        "1,1,1,1",
        "-ot",
        "^blk\\.(7|8|9|11)\\.ffn_(gate|up|down)_exps\\.weight$=CUDA0,^blk\\.(14|18|19|22)\\.ffn_(gate|up|down)_exps\\.weight$=CUDA1,^blk\\.(31|33|34|35)\\.ffn_(gate|up|down)_exps\\.weight$=CUDA2,^blk\\.(36|38|39|42)\\.ffn_(gate|up|down)_exps\\.weight$=CUDA3,^blk\\.[0-9]+\\.ffn_(gate|up|down)_exps\\.weight$=CPU",
        "-t",
        "16",
        "-tb",
        "16",
        "-b",
        "2048",
        "-ub",
        "2048",
        "-fa",
        "on",
        "-ctk",
        "f16",
        "-ctv",
        "f16",
        "--no-warmup",
        "-c",
        "65536",
        "-np",
        "1",
        "--no-context-shift",
        "--jinja",
        "--host",
        "127.0.0.1",
        "--port",
        "8470"
      ],
      "env": {
        "CUDA_VISIBLE_DEVICES": "$GPU0,$GPU1,$GPU2,$GPU3",
        "LLAMA_OFFLINE": "1"
      }
    },
