From 3a88439bfafd2fca5904585a2f1accaf0d6551b2 Mon Sep 17 00:00:00 2001
From: Nick Mermiges <Mermiges@users.noreply.github.com>
Date: Fri Oct 9 19:41:41 2026 +0000
Subject: [PATCH] glm5-next: fill t_layer_inp for DFlash (pattern from ggml-org/llama.cpp#30093)


diff --git a/src/models/glm5-next.cpp b/src/models/glm5-next.cpp
index 48b07f1e2..7b6a7672a 100644
--- a/src/models/glm5-next.cpp
+++ b/src/models/glm5-next.cpp
@@ -702,6 +702,11 @@ llama_model_glm5_next::graph::graph(const llama_model & model, const llm_graph_p
     ggml_tensor * prev_sel = nullptr;
 
     for (int il = 0; il < n_layer; ++il) {
+        if ((size_t) il < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[il]) {
+            res->t_layer_inp[il] = build_hc_mean(inpL);
+            cb(res->t_layer_inp[il], "layer_inp", il);
+            ggml_build_forward_expand(gf, res->t_layer_inp[il]);
+        }
         const auto & layer = model.layers[il];
 
         ggml_tensor * residual = inpL;
@@ -769,6 +774,12 @@ llama_model_glm5_next::graph::graph(const llama_model & model, const llm_graph_p
         cb(inpL, "l_out", il);
     }
 
+    if ((size_t) n_layer < cparams.embeddings_layer_inp.size() && cparams.embeddings_layer_inp[n_layer]) {
+        res->t_layer_inp[n_layer] = build_hc_mean(inpL);
+        cb(res->t_layer_inp[n_layer], "layer_inp", n_layer);
+        ggml_build_forward_expand(gf, res->t_layer_inp[n_layer]);
+    }
+
     // narrow to the output tokens, then collapse the streams
     // Unmasked nextn embeddings need all rows.
     if (crop_before_nextn(inp_out_ids)) {
