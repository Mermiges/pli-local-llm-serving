From 69235060cc2b67b3df45e18cba5fadcff9c93331 Mon Sep 17 00:00:00 2001
From: Nick Mermiges <Mermiges@users.noreply.github.com>
Date: Sat, 10 Oct 2026 09:41:17 +0000
Subject: [PATCH 1/2] tests: MUL_MAT_ID MMQ tail tile past compact src1
 (DeepSeek V4.1 Xid 31 reproducer)

Fixed routing and sizes put the quantized src1 of MUL_MAT_ID exactly at the end of a fresh
2 MiB VMM pool granule, so an unpadded src1 makes the last expert tail tile read unmapped memory.
Run alone: test-backend-ops -o MUL_MAT_ID -p y_tail.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tests/test-backend-ops.cpp | 60 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 60 insertions(+)

diff --git a/tests/test-backend-ops.cpp b/tests/test-backend-ops.cpp
index 2deb90f6a..d1aab3dc4 100644
--- a/tests/test-backend-ops.cpp
+++ b/tests/test-backend-ops.cpp
@@ -5054,6 +5054,61 @@ struct test_mul_mat_id : public test_case {
     }
 };
 
+// GGML_OP_MUL_MAT_ID, MMQ tail tile of the last expert.
+// MMQ loads whole J-column src1 tiles, so the last tile of the last expert reads past the compact quantized src1.
+// Fixed routing (token t uses experts t*n_used .. t*n_used + 3, mod 1000) leaves 3 tokens on expert 999, and the
+// sizes make the pool allocations 14336 + 14336 + 4096 + 2064384 bytes = exactly one 2 MiB VMM granule, so a src1
+// without tail padding ends on unmapped memory and the 128-column tile faults (Xid 31) instead of reading stale
+// pool bytes. Needs a fresh pool: run it alone, e.g. test-backend-ops -o MUL_MAT_ID -p y_tail.
+struct test_mul_mat_id_y_tail : public test_case {
+    static constexpr int     n_mats = 1000;
+    static constexpr int     n_used = 4;
+    static constexpr int64_t m      = 128;
+    static constexpr int64_t n      = 896;
+    static constexpr int64_t k      = 512;
+    const bool b; // broadcast b matrix
+
+    std::string vars() override {
+        return "y_tail," + VARS_TO_STR1(b);
+    }
+
+    double max_nmse_err() override {
+        return 5e-4;
+    }
+
+    test_mul_mat_id_y_tail(bool b) : b(b) {}
+
+    ggml_tensor * build_graph(ggml_context * ctx) override {
+        ggml_tensor * as = ggml_new_tensor_3d(ctx, GGML_TYPE_MXFP4, k, m, n_mats);
+        ggml_set_name(as, "as");
+
+        ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, n_used, n);
+        ggml_set_name(ids, "ids");
+
+        ggml_tensor * b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k, this->b ? 1 : n_used, n);
+        ggml_set_name(b, "b");
+
+        ggml_tensor * out = ggml_mul_mat_id(ctx, as, b, ids);
+        ggml_set_name(out, "out");
+
+        return out;
+    }
+
+    void initialize_tensors(ggml_context * ctx) override {
+        for (ggml_tensor * t = ggml_get_first_tensor(ctx); t != NULL; t = ggml_get_next_tensor(ctx, t)) {
+            if (t->type != GGML_TYPE_I32) {
+                init_tensor_uniform(t);
+                continue;
+            }
+            std::vector<int32_t> data(n_used*n);
+            for (size_t i = 0; i < data.size(); i++) {
+                data[i] = i % n_mats;
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, ggml_nbytes(t));
+        }
+    }
+};
+
 // GGML_OP_MUL_MAT_ID + GGML_OP_ADD or GGML_OP_MUL
 struct test_mul_mat_id_fusion : public test_case {
     const ggml_type type_a;
@@ -9975,6 +10030,11 @@ static std::vector<std::unique_ptr<test_case>> make_test_cases_eval() {
     }
     test_cases.emplace_back(new test_mul_mat_id_fusion(GGML_TYPE_F16, GGML_TYPE_F32, 16, 16, false, 32, 32, 32, 3));
 
+    // DeepSeek V4.1 Xid 31: MMQ tail tile past the compact src1 of MUL_MAT_ID
+    for (bool b : {true, false}) {
+        test_cases.emplace_back(new test_mul_mat_id_y_tail(b));
+    }
+
     // gpt-oss issue with Vulkan mmq_id
     test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_MXFP4, GGML_TYPE_F32, 32, 2, false, 2880, 32, 2880));
     test_cases.emplace_back(new test_mul_mat_id(GGML_TYPE_Q4_0, GGML_TYPE_F32, 32, 2, false, 2880, 32, 2880));
-- 
