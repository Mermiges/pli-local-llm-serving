From 7cd3016762d93aa877d8a48c1402d7755fe4ebdb Mon Sep 17 00:00:00 2001
From: Nick Mermiges <Mermiges@users.noreply.github.com>
Date: Sat, 10 Oct 2026 09:41:29 +0000
Subject: [PATCH 2/2] CUDA: pad MUL_MAT_ID MMQ src1 for the widest selectable
 tile (fix DeepSeek V4.1 Xid 31)

The ids path sized the src1 tail padding from ne11, which is 1 (broadcast gate/up) or
n_expert_used (down), so ggml_cuda_mmq_get_J_max returned 0 and no padding was added. The tile
width J is chosen against the token count, and the last tile of the last expert loads J full
columns, reading up to J-1 columns (18 KiB at J=128) past the buffer. When that buffer ends a
fresh VMM pool high-water mark the read hits unmapped memory: Xid 31 FAULT_PDE at a 2 MiB
boundary on the expert card, request 3 of legal FULL O1. Regression from the MMQ config
refactor 6eddde06a, which replaced get_mmq_x_max_host(cc) with get_J_max(..., ne11).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ggml/src/ggml-cuda/mmq.cu  | 5 ++++-
 ggml/src/ggml-cuda/mmq.cuh | 5 ++++-
 2 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/ggml/src/ggml-cuda/mmq.cu b/ggml/src/ggml-cuda/mmq.cu
index 9b6038adf..45eb9adb4 100644
--- a/ggml/src/ggml-cuda/mmq.cu
+++ b/ggml/src/ggml-cuda/mmq.cu
@@ -202,8 +202,11 @@ void ggml_cuda_mul_mat_q(
         CUDA_CHECK(cudaGetLastError());
     }
 
+    // MMQ loads whole J-column src1 tiles and J is picked against ncols_opt (tokens), not ne11 (1 or n_expert_used),
+    // so the last tile of the last expert reads up to J-1 columns past the compact src1. Pad for the widest tile:
+    // sizing this from ne11 gave zero padding and the read ran off the end of the VMM pool (Xid 31).
     const size_t nbytes_src1_q8_1 = ne12*n_expert_used*ne10_padded * y_block_size/y_values_per_block +
-        ggml_cuda_mmq_get_J_max(src0->type, fallback, cc, ne11) * sizeof(block_q8_1_mmq);
+        ggml_cuda_mmq_get_J_max(src0->type, fallback, cc, MMQ_J_SELECT_MAX) * sizeof(block_q8_1_mmq);
     ggml_cuda_pool_alloc<char> src1_q8_1(ctx.pool(), nbytes_src1_q8_1);
     ggml_cuda_pool_alloc<float> src1_scale(ctx.pool());
     if (src0->type == GGML_TYPE_NVFP4 && use_native_fp4) {
diff --git a/ggml/src/ggml-cuda/mmq.cuh b/ggml/src/ggml-cuda/mmq.cuh
index 24afedd14..e2819e51c 100644
--- a/ggml/src/ggml-cuda/mmq.cuh
+++ b/ggml/src/ggml-cuda/mmq.cuh
@@ -363,6 +363,9 @@ static constexpr __device__ int ggml_cuda_mmq_get_sram_stride(ggml_type type, in
     return ggml_cuda_mmq_get_sram_stride(ggml_cuda_mmq_get_sram_layout(type, J, fallback));
 }
 
+// Widest tile in the src1/dst column direction that mul_mat_q_switch_J may select.
+static constexpr int MMQ_J_SELECT_MAX = 128;
+
 static __host__ int ggml_cuda_mmq_get_J_max(const ggml_type type, const bool fallback, const int cc, const int64_t ne11) {
     int ret = std::min(ne11, int64_t(512));
     ret -= ret % 8;
@@ -1477,7 +1480,7 @@ void mul_mat_q_switch_J(ggml_backend_cuda_context & ctx, const mmq_args & args,
     int J_best        = 0;
     int ntiles_J_best = INT_MAX;
 
-    for (int J = 8; J <= 128 && ntiles_J_best > 1; J += 8) {
+    for (int J = 8; J <= MMQ_J_SELECT_MAX && ntiles_J_best > 1; J += 8) {
         const ggml_cuda_mmq_config config = ggml_cuda_mmq_get_config(type, J, fallback, cc);
         if (config.type == GGML_TYPE_COUNT) {
             continue;
-- 
